{
    "version": "2.0.0",
    "inputs": [
        {
            "id": "selectProject",
            "description": "选择项目",
            "type": "pickString",
            "options": [
                "/Template/AotTest/AotTest.csproj",
                "/Template/Test1/Test1.csproj",
                "/Aot_MakeGenericMethod/Aot_MakeGenericMethod.csproj"
            ]
        },
        {
            "id": "isAot",
            "description": "是否为 AOT 模式",
            "type": "pickString",
            "options": ["-nativeaot", ""],
            "default": "-nativeaot"
        }
    ],
    "tasks": [
        // 直接使用 dotnet 构建(不支持 aot，debug 时推荐)
        {
            "label": "构建项目(快)",
            "type": "process",
            "command": "dotnet",
            "args": ["build", "${workspaceFolder}${input:selectProject}"],
            "problemMatcher": ["$msCompile"]
        },
        // 使用 runtime 测试脚本构建(支持 aot)
        {
            "label": "构建项目(慢)",
            "type": "shell",
            "command": "${workspaceFolder}/../build.sh",
            "args": [
                "${input:isAot}",
                "-test:${workspaceFolderBasename}${input:selectProject}"
            ],
            "problemMatcher": ["$msCompile"]
        },
        // 先构建 Clr.NativeAotLibs，再使用 aot 构建项目，在 clr 中的 nativeaot 修改后测试时才需要执行
        {
            "label": "构架 clr.aot && Aot 构建项目(慢)",
            "type": "shell",
            "command": "${workspaceFolder}/../build.sh",
            "args": [
                "-nativeaot",
                "-test:${workspaceFolderBasename}${input:selectProject}"
            ],
            "problemMatcher": ["$msCompile"],
            "dependsOn": ["Build Clr.NativeAotLibs"],
            "dependsOrder": "sequence"
        },

        // 构建 Clr.NativeCoreLib，clr 中的 System.Private.CoreLib 修改后需要执行
        {
            "label": "Build Clr.NativeCoreLib",
            "type": "shell",
            "command": "${workspaceFolder}/../../../build.sh",
            "args": ["-s", "Clr.NativeCoreLib"],
            "problemMatcher": ["$msCompile"]
        },
        // 构建 CoreRoot，clr 中的 System.Private.CoreLib 修改后需要执行
        {
            "label": "Build CoreRoot",
            "type": "shell",
            "command": "${workspaceFolder}/../build.sh",
            "args": ["-generatelayoutonly"],
            "problemMatcher": ["$msCompile"],
            "dependsOn": ["Build Clr.NativeCoreLib"],
            "dependsOrder": "sequence"
        },
        // 构建 Clr.NativeAotLibs，在 clr 中的 nativeaot 修改后才需要执行
        {
            "label": "Build Clr.NativeAotLibs",
            "type": "shell",
            "command": "${workspaceFolder}/../../../build.sh",
            "args": ["-s", "Clr.NativeAotLibs"],
            "problemMatcher": ["$msCompile"]
        }
    ]
}
